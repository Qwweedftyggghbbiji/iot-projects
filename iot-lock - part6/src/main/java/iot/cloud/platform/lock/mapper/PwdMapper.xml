<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="iot.cloud.platform.lock.mapper.PwdMapper">

    <!-- 获取当前启用的固定密码 -->
    <select id="getFixedPwd" resultType="java.lang.String">
        SELECT `pwd` FROM `pwd`
        WHERE `typ` = 'fixed' AND `status` = 'enabled'
        LIMIT 1
    </select>

    <!-- 更新固定密码，同时更新更新时间 -->
    <update id="updateFixedPwd" parameterType="java.lang.String">
        UPDATE `pwd`
        SET `pwd` = #{newPwd}, `upt_time` = NOW()
        WHERE `typ` = 'fixed' AND `status` = 'enabled'
    </update>

</mapper>